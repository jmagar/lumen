#!/usr/bin/env bash
set -euo pipefail

PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"

OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"
case "$ARCH" in
  x86_64)  ARCH="amd64" ;;
  aarch64) ARCH="arm64" ;;
esac

# Check for binary: local build first, then plugin cache, then download
BINARY=""
for candidate in \
  "${LUMEN_BINARY:-}" \
  "${HOME}/.local/share/lumen/bin/lumen" \
  "${PLUGIN_ROOT}/bin/lumen" \
  "${PLUGIN_ROOT}/bin/lumen-${OS}-${ARCH}"; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    BINARY="$candidate"
    break
  fi
done

if [ -z "$BINARY" ]; then
  BINARY="${PLUGIN_ROOT}/bin/lumen-${OS}-${ARCH}"
  REPO="jmagar/lumen"

  AUTH_ARGS=()
  if [ -n "${GITHUB_TOKEN:-}" ]; then
    AUTH_ARGS=(-H "Authorization: token $GITHUB_TOKEN")
  fi

  LATEST_TAG=$(curl -sfL "${AUTH_ARGS[@]}" \
    --max-time 30 --retry 2 --retry-delay 2 \
    "https://api.github.com/repos/${REPO}/releases/latest" \
    | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')

  if [ -z "$LATEST_TAG" ] || ! echo "$LATEST_TAG" | grep -qE '^v[0-9]'; then
    echo "Error: could not resolve latest release from https://github.com/${REPO}" >&2
    exit 1
  fi

  ASSET="lumen-${LATEST_TAG#v}-${OS}-${ARCH}"
  URL="https://github.com/${REPO}/releases/download/${LATEST_TAG}/${ASSET}"

  echo "Downloading lumen ${LATEST_TAG} for ${OS}/${ARCH}..." >&2
  mkdir -p "$(dirname "$BINARY")"
  curl -fL --progress-bar --max-time 300 --retry 3 --retry-delay 2 "$URL" -o "$BINARY"
  chmod +x "$BINARY"
  echo "Installed lumen to ${BINARY}" >&2
fi

exec "$BINARY" "$@"
